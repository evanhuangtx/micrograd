    "from graphviz import Digraph\n",
    "\n",
    "def trace(root):\n",
    "    nodes, edges = set(), set()            # was \"notes\"\n",
    "    def build(v):\n",
    "        if v not in nodes:\n",
    "            nodes.add(v)                   # was \"node.add\"\n",
    "            for child in v._prev:\n",
    "                edges.add((child, v))\n",
    "                build(child)\n",
    "    build(root)                            # dedented: now part of trace\n",
    "    return nodes, edges                    # dedented: now part of trace\n",
    "\n",
    "def draw_dot(root):\n",
    "    dot = Digraph(format='svg', graph_attr={'rankdir': 'LR'})\n",
    "\n",
    "    nodes, edges = trace(root)\n",
    "    for n in nodes:                        # was \"nods\"\n",
    "        uid = str(id(n))\n",
    "        dot.node(name=uid, label=\"{ %s | data %.4f |grad %.4f }\" % (n.label, n.data, n.grad), shape='record')\n",
    "        if n._op:                          # was \"n.op\"\n",
    "            dot.node(name=uid + n._op, label=n._op)\n",
    "            dot.edge(uid + n._op, uid)     # connect the op node to its result\n",
    "\n",
    "    for n1, n2 in edges:                   # draw the edges between values\n",
    "        dot.edge(str(id(n1)), str(id(n2)) + n2._op)\n",
    "\n",
    "    return dot"
   ]
